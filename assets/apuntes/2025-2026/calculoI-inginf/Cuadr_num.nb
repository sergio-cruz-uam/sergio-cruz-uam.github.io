Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "quadCompositeGrid", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"quadCompositeGrid", "[", 
    RowBox[{"n_Integer", "?", "Positive"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "h", ",", "nodes", ",", "mids", ",", "exact", ",", "exactN", ",", 
       "yMax", ",", "qR", ",", "qPM", ",", "qT", ",", "qS", ",", "eR", ",", 
       "ePM", ",", "eT", ",", "eS", ",", "base", ",", "partLines", ",", 
       "rectFill", ",", "midFill", ",", "trapFill", ",", "simpsonPolys", ",", 
       "pPiece", ",", "simpsonPlot", ",", "gRect", ",", "gMid", ",", "gTrap", 
       ",", "gSimp", ",", "panel", ",", "header"}], "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"ValueQ", "[", "A", "]"}]}], ",", 
        RowBox[{"A", "=", 
         RowBox[{
          RowBox[{"Integrate", "[", 
           RowBox[{
            RowBox[{"f", "[", "x", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "a", ",", "b"}], "}"}]}], "]"}], "//", 
          "FullSimplify"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"exact", "=", "A"}], ";", "\[IndentingNewLine]", 
      RowBox[{"exactN", "=", 
       RowBox[{"N", "[", 
        RowBox[{"exact", ",", "30"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"h", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"b", "-", "a"}], ")"}], "/", "n"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"nodes", "=", 
       RowBox[{"Subdivide", "[", 
        RowBox[{"a", ",", "b", ",", "n"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"mids", "=", 
       RowBox[{
        RowBox[{"Most", "[", "nodes", "]"}], "+", 
        RowBox[{"h", "/", "2"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"yMax", "=", 
       RowBox[{"1.08", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"f", "/@", 
          RowBox[{"Subdivide", "[", 
           RowBox[{"a", ",", "b", ",", "400"}], "]"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"base", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"f", "[", "x", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "a", ",", "b"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", "Thick"}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"a", ",", "b"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "yMax"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"AxesOrigin", "->", 
          RowBox[{"{", 
           RowBox[{"a", ",", "0"}], "}"}]}], ",", 
         RowBox[{"ImageSize", "->", "420"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"partLines", "=", 
       RowBox[{"Graphics", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"GrayLevel", "[", ".85", "]"}], ",", 
          RowBox[{"AbsoluteThickness", "[", "1", "]"}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"xi", ",", "0"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"xi", ",", "yMax"}], "}"}]}], "}"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"xi", ",", "nodes"}], "}"}]}], "]"}]}], "}"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"qR", "=", 
       RowBox[{"h", " ", 
        RowBox[{"Total", "[", 
         RowBox[{"f", "/@", 
          RowBox[{"Most", "[", "nodes", "]"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"eR", "=", 
       RowBox[{"qR", "-", "exactN"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"qPM", "=", 
       RowBox[{"h", " ", 
        RowBox[{"Total", "[", 
         RowBox[{"f", "/@", "mids"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ePM", "=", 
       RowBox[{"qPM", "-", "exactN"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"qT", "=", 
       RowBox[{"h", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"f", "[", "a", "]"}], "+", 
             RowBox[{"f", "[", "b", "]"}]}], ")"}], "/", "2"}], "+", 
          RowBox[{"Total", "[", 
           RowBox[{"f", "/@", 
            RowBox[{"nodes", "[", 
             RowBox[{"[", 
              RowBox[{"2", ";;", 
               RowBox[{"-", "2"}]}], "]"}], "]"}]}], "]"}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"eT", "=", 
       RowBox[{"qT", "-", "exactN"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"EvenQ", "[", "n", "]"}], ",", 
        RowBox[{
         RowBox[{"qS", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"h", "/", "3"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"f", "[", "a", "]"}], "+", 
             RowBox[{"f", "[", "b", "]"}], "+", 
             RowBox[{"4", " ", 
              RowBox[{"Total", "[", 
               RowBox[{"f", "/@", 
                RowBox[{"nodes", "[", 
                 RowBox[{"[", 
                  RowBox[{"2", ";;", 
                   RowBox[{"-", "1"}], ";;", "2"}], "]"}], "]"}]}], "]"}]}], "+", 
             RowBox[{"2", " ", 
              RowBox[{"Total", "[", 
               RowBox[{"f", "/@", 
                RowBox[{"nodes", "[", 
                 RowBox[{"[", 
                  RowBox[{"3", ";;", 
                   RowBox[{"-", "2"}], ";;", "2"}], "]"}], "]"}]}], "]"}]}]}],
             ")"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"eS", "=", 
          RowBox[{"qS", "-", "exactN"}]}], ";"}], ",", 
        RowBox[{
         RowBox[{"qS", "=", 
          RowBox[{"Missing", "[", "\"\<EvenNRequired\>\"", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"eS", "=", 
          RowBox[{"Missing", "[", "\"\<EvenNRequired\>\"", "]"}]}], ";"}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"rectFill", "=", 
       RowBox[{"Graphics", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Opacity", "[", ".20", "]"}], ",", 
          RowBox[{"EdgeForm", "[", 
           RowBox[{"GrayLevel", "[", ".4", "]"}], "]"}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"xL", "=", 
                 RowBox[{"nodes", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], ",", 
                RowBox[{"xR", "=", 
                 RowBox[{"nodes", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", 
                RowBox[{"hh", "=", 
                 RowBox[{"f", "[", 
                  RowBox[{"nodes", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "]"}]}]}], "}"}], ",", 
              RowBox[{"Polygon", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"xL", ",", "0"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"xR", ",", "0"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"xR", ",", "hh"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"xL", ",", "hh"}], "}"}]}], "}"}], "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], "}"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"midFill", "=", 
       RowBox[{"Graphics", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Opacity", "[", ".20", "]"}], ",", 
          RowBox[{"EdgeForm", "[", 
           RowBox[{"GrayLevel", "[", ".4", "]"}], "]"}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"xL", "=", 
                 RowBox[{"nodes", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], ",", 
                RowBox[{"xR", "=", 
                 RowBox[{"nodes", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", 
                RowBox[{"hh", "=", 
                 RowBox[{"f", "[", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"nodes", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "+", 
                    RowBox[{"nodes", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ")"}], "/", 
                   "2"}], "]"}]}]}], "}"}], ",", 
              RowBox[{"Polygon", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"xL", ",", "0"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"xR", ",", "0"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"xR", ",", "hh"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"xL", ",", "hh"}], "}"}]}], "}"}], "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], "}"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"trapFill", "=", 
       RowBox[{"Graphics", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Opacity", "[", ".20", "]"}], ",", 
          RowBox[{"EdgeForm", "[", 
           RowBox[{"GrayLevel", "[", ".4", "]"}], "]"}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"xL", "=", 
                 RowBox[{"nodes", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], ",", 
                RowBox[{"xR", "=", 
                 RowBox[{"nodes", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", 
                RowBox[{"hL", "=", 
                 RowBox[{"f", "[", 
                  RowBox[{"nodes", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", 
                RowBox[{"hR", "=", 
                 RowBox[{"f", "[", 
                  RowBox[{"nodes", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", "+", "1"}], "]"}], "]"}], "]"}]}]}], "}"}], ",", 
              RowBox[{"Polygon", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"xL", ",", "0"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"xR", ",", "0"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"xR", ",", "hR"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"xL", ",", "hL"}], "}"}]}], "}"}], "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], "}"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"EvenQ", "[", "n", "]"}], ",", 
        RowBox[{
         RowBox[{"simpsonPolys", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"x0", "=", 
                 RowBox[{"nodes", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"2", " ", "k"}], "+", "1"}], "]"}], "]"}]}], ",", 
                RowBox[{"x1", "=", 
                 RowBox[{"nodes", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"2", " ", "k"}], "+", "2"}], "]"}], "]"}]}], ",", 
                RowBox[{"x2", "=", 
                 RowBox[{"nodes", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"2", " ", "k"}], "+", "3"}], "]"}], "]"}]}]}], 
               "}"}], ",", 
              RowBox[{"InterpolatingPolynomial", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"x0", ",", 
                    RowBox[{"f", "[", "x0", "]"}]}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"x1", ",", 
                    RowBox[{"f", "[", "x1", "]"}]}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"x2", ",", 
                    RowBox[{"f", "[", "x2", "]"}]}], "}"}]}], "}"}], ",", 
                "x"}], "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "0", ",", 
              RowBox[{
               RowBox[{"n", "/", "2"}], "-", "1"}]}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"pPiece", "[", "x_", "]"}], ":=", 
          RowBox[{"Piecewise", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"With", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"xL", "=", 
                   RowBox[{"nodes", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"2", " ", "k"}], "+", "1"}], "]"}], "]"}]}], ",", 
                  RowBox[{"xR", "=", 
                   RowBox[{"nodes", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"2", " ", "k"}], "+", "3"}], "]"}], "]"}]}]}], 
                 "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"simpsonPolys", "[", 
                   RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}], ",", 
                  RowBox[{"xL", "<=", "x", "<=", "xR"}]}], "}"}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "0", ",", 
                RowBox[{
                 RowBox[{"n", "/", "2"}], "-", "1"}]}], "}"}]}], "]"}], ",", 
            "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"simpsonPlot", "=", 
          RowBox[{"Plot", "[", 
           RowBox[{
            RowBox[{"pPiece", "[", "x", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "a", ",", "b"}], "}"}], ",", 
            RowBox[{"PlotStyle", "->", 
             RowBox[{"{", 
              RowBox[{"Thick", ",", "Dashed", ",", 
               RowBox[{"GrayLevel", "[", ".35", "]"}]}], "}"}]}], ",", 
            RowBox[{"PlotRange", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"a", ",", "b"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"0", ",", "yMax"}], "}"}]}], "}"}]}], ",", 
            RowBox[{"Filling", "->", "0"}], ",", 
            RowBox[{"FillingStyle", "->", 
             RowBox[{"Opacity", "[", ".20", "]"}]}], ",", 
            RowBox[{"ImageSize", "->", "420"}]}], "]"}]}], ";"}]}], "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"gRect", "=", 
       RowBox[{"Show", "[", 
        RowBox[{"base", ",", "rectFill", ",", "partLines"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gMid", "=", 
       RowBox[{"Show", "[", 
        RowBox[{"base", ",", "midFill", ",", "partLines"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gTrap", "=", 
       RowBox[{"Show", "[", 
        RowBox[{"base", ",", "trapFill", ",", "partLines"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gSimp", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"EvenQ", "[", "n", "]"}], ",", 
         RowBox[{"Show", "[", 
          RowBox[{"base", ",", "simpsonPlot", ",", "partLines"}], "]"}], ",", 
         RowBox[{"Show", "[", 
          RowBox[{"base", ",", "partLines", ",", 
           RowBox[{"PlotLabel", "->", 
            RowBox[{"Style", "[", 
             
             RowBox[{"\"\<Simpson requiere n par\>\"", ",", "14", ",", 
              "Red"}], "]"}]}]}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"panel", "[", 
        RowBox[{"g_", ",", "name_", ",", "q_", ",", "e_"}], "]"}], ":=", 
       RowBox[{"Labeled", "[", 
        RowBox[{
         RowBox[{"Show", "[", 
          RowBox[{"g", ",", 
           RowBox[{"PlotLabel", "->", "None"}], ",", 
           RowBox[{"ImageSize", "->", "420"}]}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MissingQ", "[", "q", "]"}], ",", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"name", ",", "\"\<   (n debe ser par)\>\""}], "}"}], 
              "]"}], ",", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"name", ",", "\"\<   Aprox. \[TildeTilde] \>\"", ",", 
                RowBox[{"NumberForm", "[", 
                 RowBox[{
                  RowBox[{"N", "[", 
                   RowBox[{"q", ",", "20"}], "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"12", ",", "10"}], "}"}]}], "]"}], 
                ",", "\"\<   |E| \[TildeTilde] \>\"", ",", 
                RowBox[{"NumberForm", "[", 
                 RowBox[{
                  RowBox[{"N", "[", 
                   RowBox[{
                    RowBox[{"Abs", "[", "e", "]"}], ",", "20"}], "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"12", ",", "8"}], "}"}]}], "]"}]}], "}"}], "]"}]}],
             "]"}], ",", "14"}], "]"}], ",", "Top"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"header", "=", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<\[CapitalAAcute]rea exacta  \[TildeTilde]  \>\"", ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{"exactN", ",", 
              RowBox[{"{", 
               RowBox[{"12", ",", "10"}], "}"}]}], "]"}], 
            ",", "\"\<     (n = \>\"", ",", "n", ",", "\"\<)\>\""}], "}"}], 
          "]"}], ",", "14", ",", "Bold"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Labeled", "[", 
       RowBox[{
        RowBox[{"GraphicsGrid", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"panel", "[", 
               RowBox[{
               "gRect", ",", "\"\<Rect\[AAcute]ngulo comp.\>\"", ",", "qR", ",",
                 "eR"}], "]"}], ",", 
              RowBox[{"panel", "[", 
               RowBox[{
               "gMid", ",", "\"\<Punto medio comp.\>\"", ",", "qPM", ",", 
                "ePM"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"panel", "[", 
               RowBox[{
               "gTrap", ",", "\"\<Trapecio comp.\>\"", ",", "qT", ",", "eT"}],
                "]"}], ",", 
              RowBox[{"panel", "[", 
               RowBox[{
               "gSimp", ",", "\"\<Simpson comp.\>\"", ",", "qS", ",", "eS"}], 
               "]"}]}], "}"}]}], "}"}], ",", 
          RowBox[{"Spacings", "->", 
           RowBox[{"{", 
            RowBox[{"0.6", ",", "0.9"}], "}"}]}]}], "]"}], ",", "header", ",",
         "Top"}], "]"}]}]}], "]"}]}], ";"}]}], "Input",
