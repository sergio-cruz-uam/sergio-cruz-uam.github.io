Cell[TextData[{
 StyleBox["4. ",
  FontSize->16,
  FontWeight->"Bold",
  FontColor->RGBColor[0.98, 0.56, 0.17]],
 StyleBox["- Regla simple de Simpson. Se calcula el \[AAcute]rea bajo el \
polinomio de segundo grado que pasa por (a,f(a)), (b,f(b)) y (c,f(c)).",
  FontSize->16,
  FontColor->RGBColor[0.98, 0.56, 0.17]]
}], "Text",
 CellChangeTimes->{{3.9750724166448574`*^9, 3.975072467129961*^9}, {
  3.97507250607847*^9, 3.9750725138614464`*^9}, {3.9750725875690365`*^9, 
  3.9750726155626736`*^9}, {3.9750753520892696`*^9, 
  3.975075370819435*^9}},ExpressionUUID->"9f4dbecf-5e72-214c-96f1-\
e2a6d09cc3ea"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"QS", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"b", "-", "a"}], ")"}], "/", "6"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"f", "[", "a", "]"}], "+", 
       RowBox[{"4", " ", 
        RowBox[{"f", "[", "c", "]"}]}], "+", 
       RowBox[{"f", "[", "b", "]"}]}], ")"}]}], "//", "FullSimplify"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"ES", "=", 
   RowBox[{
    RowBox[{"QS", "-", "A"}], "//", "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p", "[", "x_", "]"}], "=", 
   RowBox[{
    RowBox[{"InterpolatingPolynomial", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", ",", 
          RowBox[{"f", "[", "a", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"c", ",", 
          RowBox[{"f", "[", "c", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"b", ",", 
          RowBox[{"f", "[", "b", "]"}]}], "}"}]}], "}"}], ",", "x"}], "]"}], "//",
     "Expand"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"yMax", "=", 
   RowBox[{"1.08", " ", 
    RowBox[{"Max", "[", 
     RowBox[{"f", "/@", 
      RowBox[{"Subdivide", "[", 
       RowBox[{"a", ",", "b", ",", "300"}], "]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pBase", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "a", ",", "b"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Thick"}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "yMax"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"AxesOrigin", "->", 
      RowBox[{"{", 
       RowBox[{"a", ",", "0"}], "}"}]}], ",", 
     RowBox[{"ImageSize", "->", "560"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pSim", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"p", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "a", ",", "b"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Dashed", ",", 
        RowBox[{"GrayLevel", "[", ".35", "]"}]}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "yMax"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"Filling", "->", "0"}], ",", 
     RowBox[{"FillingStyle", "->", 
      RowBox[{"Opacity", "[", ".20", "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"pBase", ",", "pSim", ",", 
   RowBox[{"Graphics", "[", 
    RowBox[{"{", 
     RowBox[{"Black", ",", 
      RowBox[{"PointSize", "[", "0.015", "]"}], ",", 
      RowBox[{"Point", "[", 
       RowBox[{"{", 
        RowBox[{"a", ",", 
         RowBox[{"f", "[", "a", "]"}]}], "}"}], "]"}], ",", 
      RowBox[{"Point", "[", 
       RowBox[{"{", 
        RowBox[{"c", ",", 
         RowBox[{"f", "[", "c", "]"}]}], "}"}], "]"}], ",", 
      RowBox[{"Point", "[", 
       RowBox[{"{", 
        RowBox[{"b", ",", 
         RowBox[{"f", "[", "b", "]"}]}], "}"}], "]"}]}], "}"}], "]"}], ",", 
   RowBox[{"PlotLabel", "->", 
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<Simpson: \>\"", ",", "QS", ",", "\"\<  \[TildeTilde]  \>\"",
        ",", 
       RowBox[{"NumberForm", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"QS", ",", "5"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"12", ",", "5"}], "}"}]}], "]"}], ",", "\"\<     Error \>\"",
        ",", "\"\<  \[TildeTilde]  \>\"", ",", 
       RowBox[{"NumberForm", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"ES", ",", "20"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"12", ",", "10"}], "}"}]}], "]"}]}], "}"}], "]"}]}]}], 
  "]"}], "\n", 
 RowBox[{
  RowBox[{"gSimp", "=", "%"}], ";"}], "\n"}], "Input",
 CellChangeTimes->{{3.975072403131819*^9, 3.975072403131819*^9}, {
   3.975072518879236*^9, 3.9750725652867947`*^9}, 3.9750727412784557`*^9, {
   3.9750728240844517`*^9, 3.97507283343198*^9}, {3.9750736215701485`*^9, 
   3.9750736232318707`*^9}},
