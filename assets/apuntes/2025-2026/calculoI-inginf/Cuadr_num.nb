Cell[TextData[{
 "La primitiva de f(x) no puede escribirse usando las funciones que hemos \
visto en el curso. Se obtiene usando la exponencial integral Ei(x), que se \
define como una funci\[OAcute]n de \[AAcute]rea de ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["e", "x"], "/", "x"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6f82df58-7365-8942-914d-cbc26b897345"],
 ". "
}], "Text",
 CellChangeTimes->{{3.975070471020588*^9, 
  3.9750706159911137`*^9}},ExpressionUUID->"c035be72-26e3-ba4c-b5b4-\
0fbba7714f3f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Input",
 CellChangeTimes->{{3.9750705005597897`*^9, 3.9750705072196503`*^9}, {
  3.975072690197935*^9, 3.9750726911820526`*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"86193b75-b01d-614a-8679-d5a8a8efb4cc"],

Cell[BoxData[
 FractionBox[
  RowBox[{"ExpIntegralEi", "[", 
   RowBox[{"1", "+", "x"}], "]"}], "\[ExponentialE]"]], "Output",
 CellChangeTimes->{3.9750705080345*^9, 3.975072692055771*^9, 
  3.9750737777946663`*^9, 3.975073846743639*^9, 3.975077067534977*^9, 
  3.9750773734963856`*^9, 3.975077540925144*^9},
 CellLabel->"Out[7]=",ExpressionUUID->"561bf941-5a42-7f49-ad43-32f27235e296"]
}, Open  ]],

Cell["\<\
El valor num\[EAcute]rico exacto de la integral entre [0,1] es el siguiente\
\>", "Text",
 CellChangeTimes->{{3.9750706220496216`*^9, 
  3.97507064367976*^9}},ExpressionUUID->"25d8eebc-49a3-aa4e-b780-\
1aaab861e37d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"A", ":=", 
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", "1"], 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}]}], ";", " ", 
  RowBox[{"AN", ":=", 
   RowBox[{"N", "[", 
    RowBox[{"A", ",", "10"}], "]"}]}], ";", " ", 
  RowBox[{"{", 
   RowBox[{"A", ",", "AN"}], "}"}]}]], "Input",
 CellChangeTimes->{{3.9750706451045246`*^9, 3.9750706961456623`*^9}, {
  3.975072694827671*^9, 3.9750726957293835`*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"df025e82-f628-964b-8e87-7f250d323518"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{
     RowBox[{"-", 
      RowBox[{"ExpIntegralEi", "[", "1", "]"}]}], "+", 
     RowBox[{"ExpIntegralEi", "[", "2", "]"}]}], "\[ExponentialE]"], ",", 
   "1.12538608308327088188952869578864184735`10."}], "}"}]], "Output",
 CellChangeTimes->{{3.9750706847451*^9, 3.975070697193468*^9}, 
