}, Open  ]],

Cell[TextData[{
 StyleBox["1. ",
  FontSize->16,
  FontWeight->"Bold",
  FontColor->RGBColor[0.98, 0.56, 0.17]],
 StyleBox["- Regla simple del rect\[AAcute]ngulo: aproximamos el \[AAcute]rea \
por un rect\[AAcute]ngulo de altura f(a).",
  FontSize->16,
  FontColor->RGBColor[0.98, 0.56, 0.17]]
}], "Text",
 CellChangeTimes->{{3.975070970563183*^9, 
  3.9750710118757496`*^9}},ExpressionUUID->"da71c33e-38a0-9843-ab48-\
22e8fbd920f0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Q", ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"b", "-", "a"}], ")"}], " ", 
    RowBox[{"f", "[", "a", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EE", ":=", 
   RowBox[{"Q", "-", "A"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pR", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "a", ",", "b"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Thick"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"AxesOrigin", "->", 
      RowBox[{"{", 
       RowBox[{"a", ",", "0"}], "}"}]}], ",", 
     RowBox[{"ImageSize", "->", "560"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rectPoly", "=", 
   RowBox[{"Polygon", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"b", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"b", ",", 
