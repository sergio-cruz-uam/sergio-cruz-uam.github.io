Cell[TextData[StyleBox["Reglas compuestas; se divide el intervalo en n \
subintervalos y se aplica la regla de cuadratura en cada uno. Por \
simplicidad, tomamos los intervalos de igual longitud.",
 FontSize->18,
 FontColor->RGBColor[0.8, 0.3, 0.8]]], "Text",
 CellChangeTimes->{{3.975077586213066*^9, 
  3.9750776347609863`*^9}},ExpressionUUID->"717b0a0f-7d39-8142-afd3-\
4e7ef3e2abef"],

