Cell[TextData[{
 StyleBox["3. ",
  FontSize->16,
  FontWeight->"Bold",
  FontColor->RGBColor[0.98, 0.56, 0.17]],
 StyleBox["- Regla simple del trapecio: aproximamos el \[AAcute]rea por un \
trapecio de alturas f(a) y f(b), cuyo \[AAcute]rea viene dada por \
1/2*(f(a)+f(b))(b-a).",
  FontSize->16,
  FontColor->RGBColor[0.98, 0.56, 0.17]]
}], "Text",
 CellChangeTimes->{{3.975072139092722*^9, 3.9750721535766983`*^9}, {
  3.9750721901010475`*^9, 
  3.975072241390108*^9}},ExpressionUUID->"4d3e2127-fb6c-3441-9514-\
6a4541ece38f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"QT", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"b", "-", "a"}], ")"}], "/", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"f", "[", "a", "]"}], "+", 
       RowBox[{"f", "[", "b", "]"}]}], ")"}]}], "//", "FullSimplify"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ET", "=", 
    RowBox[{
     RowBox[{"QT", "-", "A"}], "//", "FullSimplify"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pT", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"f", "[", "x", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "a", ",", "b"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", "Thick"}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"AxesOrigin", "->", 
       RowBox[{"{", 
        RowBox[{"a", ",", "0"}], "}"}]}], ",", 
      RowBox[{"ImageSize", "->", "560"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"trapPoly", "=", 
    RowBox[{"Polygon", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"b", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"b", ",", 
         RowBox[{"f", "[", "b", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"a", ",", 
         RowBox[{"f", "[", "a", "]"}]}], "}"}]}], "}"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"pT", ",", 
   RowBox[{"Graphics", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Opacity", "[", ".20", "]"}], ",", 
        RowBox[{"EdgeForm", "[", 
         RowBox[{"GrayLevel", "[", ".35", "]"}], "]"}], ",", "trapPoly"}], 
       "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"GrayLevel", "[", ".35", "]"}], ",", "Thick", ",", 
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a", ",", 
             RowBox[{"f", "[", "a", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"b", ",", 
             RowBox[{"f", "[", "b", "]"}]}], "}"}]}], "}"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"Black", ",", 
        RowBox[{"PointSize", "[", "0.015", "]"}], ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{"a", ",", 
           RowBox[{"f", "[", "a", "]"}]}], "}"}], "]"}], ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{"b", ",", 
           RowBox[{"f", "[", "b", "]"}]}], "}"}], "]"}]}], "}"}]}], "}"}], 
    "]"}], ",", 
   RowBox[{"PlotLabel", "->", 
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<\[CapitalAAcute]rea del trapecio: \>\"", ",", "QT", 
       ",", "\"\<  \[TildeTilde]  \>\"", ",", 
       RowBox[{"NumberForm", "[", 
        RowBox[{
         RowBox[{"N", "[", 
