Cell[CellGroupData[{
Cell["C\[AAcute]lculo I - 19/12/2025 - Cuadratura num\[EAcute]rica", "Section",
 CellChangeTimes->{{3.9750697433399677`*^9, 
  3.9750697712405624`*^9}},ExpressionUUID->"51b21cde-9ceb-3b4f-89f6-\
a09844fa8b04"],

Cell["\<\
Vamos a presentar m\[EAcute]todos num\[EAcute]ricos para aproximar el \
\[AAcute]rea bajo la gr\[AAcute]fica de una funci\[OAcute]n no negativa.\
\[LineSeparator]Como ejemplo usaremos la funci\[OAcute]n del ejercicio 21 de \
la hoja 6.\
\>", "Text",
 CellChangeTimes->{{3.97506979380134*^9, 
  3.9750698589132805`*^9}},ExpressionUUID->"c8734138-7f60-7f46-993d-\
52424ecff0e9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.9750698661903515`*^9, 3.9750698661903515`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"483137cc-c204-f04f-80f8-f4bd5abad531"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  FractionBox[
   SuperscriptBox["\[ExponentialE]", "x"], 
   RowBox[{"x", "+", "1"}]]}]], "Input",
 CellChangeTimes->{{3.975069872588188*^9, 3.975069893127554*^9}, {
  3.9750737554032345`*^9, 3.975073757821783*^9}, {3.975073825429884*^9, 
  3.9750738303700695`*^9}, {3.975077017116474*^9, 3.975077049797636*^9}, {
  3.9750773501336613`*^9, 3.9750773546847057`*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"69cc15d4-3893-4c46-937e-ce1714465beb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "b"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1"}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9750698801876774`*^9, 3.9750699026935062`*^9}, {
   3.975077028091303*^9, 3.9750770287451954`*^9}, 3.9750773584205437`*^9},
 CellLabel->"In[3]:=",ExpressionUUID->"dd53fc4c-0171-de43-867a-39be8cf0305f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fillUnder", "[", 
    RowBox[{"g_", ",", 
     RowBox[{"{", 
      RowBox[{"x0_", ",", "x1_"}], "}"}], ",", 
     RowBox[{"npts_", ":", "300"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"xs", ",", "pts"}], "}"}], ",", 
     RowBox[{
      RowBox[{"xs", "=", 
       RowBox[{"Subdivide", "[", 
        RowBox[{"x0", ",", "x1", ",", "npts"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pts", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"x0", ",", "0"}], "}"}], "}"}], ",", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"xs", ",", 
            RowBox[{"g", "/@", "xs"}]}], "}"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"x1", ",", "0"}], "}"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Polygon", "[", "pts", "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.975069961991768*^9, 3.975069961991768*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"bd2a4fb8-1d4e-cc4a-b423-632f23096f3f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pGlobal", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
     RowBox[{"Exclusions", "->", 
      RowBox[{"{", 
       RowBox[{"-", "1"}], "}"}]}], ",", 
     RowBox[{"PlotStyle", "->", "Thick"}], ",", 
     RowBox[{"AxesOrigin", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "2"}], ",", "6"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"ImageSize", "->", "560"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9750700177277756`*^9, 3.9750700177277756`*^9}, {
  3.975070231307478*^9, 3.9750702520635223`*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"7b08bf69-219f-864d-bb48-1f775b7b5ad1"],

Cell[CellGroupData[{

