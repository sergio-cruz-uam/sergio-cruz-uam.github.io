Cell[TextData[{
 StyleBox["2. ",
  FontSize->16,
  FontWeight->"Bold",
  FontColor->RGBColor[0.98, 0.56, 0.17]],
 StyleBox["- Regla simple del punto medio: aproximamos el \[AAcute]rea por un \
rect\[AAcute]ngulo de altura ",
  FontSize->16,
  FontColor->RGBColor[0.98, 0.56, 0.17]],
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", 
    FractionBox[
     RowBox[{"a", "+", "b"}], "2"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "36a0db6b-0ddb-0949-a1c4-5c4cf0011778"],
 StyleBox[".",
  FontSize->16,
  FontColor->RGBColor[0.98, 0.56, 0.17]]
}], "Text",
 CellChangeTimes->{{3.9750717608640633`*^9, 
  3.975071786468384*^9}},ExpressionUUID->"45b69e3a-3417-3a4b-b50f-\
710dce15343c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"c", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"a", "+", "b"}], ")"}], "/", "2"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"QPM", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"b", "-", "a"}], ")"}], " ", 
     RowBox[{"f", "[", "c", "]"}]}], "//", "FullSimplify"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"EPM", "=", 
    RowBox[{
     RowBox[{"QPM", "-", "A"}], "//", "FullSimplify"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pPM", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"f", "[", "x", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "a", ",", "b"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", "Thick"}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"AxesOrigin", "->", 
       RowBox[{"{", 
        RowBox[{"a", ",", "0"}], "}"}]}], ",", 
      RowBox[{"ImageSize", "->", "560"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"midPoly", "=", 
    RowBox[{"Polygon", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"b", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"b", ",", 
         RowBox[{"f", "[", "c", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"a", ",", 
         RowBox[{"f", "[", "c", "]"}]}], "}"}]}], "}"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"pPM", ",", 
   RowBox[{"Graphics", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Opacity", "[", ".20", "]"}], ",", 
        RowBox[{"EdgeForm", "[", 
         RowBox[{"GrayLevel", "[", ".35", "]"}], "]"}], ",", "midPoly"}], 
       "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"GrayLevel", "[", ".35", "]"}], ",", "Thick", ",", 
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a", ",", 
             RowBox[{"f", "[", "c", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"b", ",", 
             RowBox[{"f", "[", "c", "]"}]}], "}"}]}], "}"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"Black", ",", 
        RowBox[{"PointSize", "[", "0.015", "]"}], ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{"c", ",", 
           RowBox[{"f", "[", "c", "]"}]}], "}"}], "]"}]}], "}"}], ",", 
      RowBox[{"Text", "[", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<c=1/2\>\"", ",", "14", ",", "Bold", ",", "Black"}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"c", ",", 
          RowBox[{"f", "[", "c", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1.2"}], "}"}]}], "]"}]}], "\n", "}"}], "]"}], ",", 
   RowBox[{"PlotLabel", "->", 
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<\[CapitalAAcute]rea del rect\[AAcute]ngulo: \>\"", ",", 
       "QPM", ",", "\"\<  \[TildeTilde]  \>\"", ",", 
       RowBox[{"NumberForm", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"QPM", ",", "5"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"12", ",", "5"}], "}"}]}], "]"}], ",", "\"\<     Error \>\"",
        ",", "\"\<  \[TildeTilde]  \>\"", ",", 
       RowBox[{"NumberForm", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"EPM", ",", "10"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"12", ",", "10"}], "}"}]}], "]"}]}], "}"}], "]"}]}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gPM", "=", "%"}], ";"}]}], "Input",
 CellChangeTimes->{{3.9750716483238564`*^9, 3.9750716495821705`*^9}, {
